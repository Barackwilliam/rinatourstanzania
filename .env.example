# Copy to .env and fill in. NEVER commit the real .env.
#
#   Linux / macOS:   cp .env.example .env
#   Windows CMD:     copy .env.example .env
#   PowerShell:      Copy-Item .env.example .env
#
# A comment must sit on its own line. Anything written after a value is read
# as part of that value, so `MAX_VIDEO_UPLOAD_MB=45  # note` fails to start.

SECRET_KEY=generate-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com

# --- Database -----------------------------------------------------------------
# Supabase > Project Settings > Database > Connection string (URI, Session pooler).
# Leave blank locally to fall back to SQLite.
DATABASE_URL=
DB_SSL_REQUIRE=True

# Render sets this automatically in production — leave blank locally.
RENDER_EXTERNAL_HOSTNAME=

# --- Media storage: Supabase bucket (images + video) --------------------------
# Supabase > Storage > New bucket -> name it, tick PUBLIC
# Supabase > Storage > S3 Access Keys > New access key
# Supabase > Project Settings > General > Reference ID
#
# Leave SUPABASE_PROJECT_REF blank and uploads go to ./media/ locally instead.
SUPABASE_PROJECT_REF=
SUPABASE_STORAGE_BUCKET=media
SUPABASE_S3_REGION=eu-central-1
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=

# Supabase's free tier caps a single file at 50 MB, so the video limit is 45.
# Raise it to 100 once the client is on a paid plan.
# Keep values on their own line — nothing after the value, not even a comment.
MAX_IMAGE_UPLOAD_MB=8
MAX_VIDEO_UPLOAD_MB=45

# --- Client branding ----------------------------------------------------------
SITE_NAME=Rina Tours Tanzania
SITE_TAGLINE=
SITE_PHONE_PRIMARY=
SITE_PHONE_SECONDARY=
SITE_WHATSAPP=
SITE_EMAIL=
SITE_LOCATION=
SITE_INSTAGRAM=
SITE_FACEBOOK=
SITE_TIKTOK=
SITE_THREADS=

# --- SEO ----------------------------------------------------------------------
SITE_DOMAIN=https://rinatourstanzania.com
SITE_MAP_EMBED_URL=
GOOGLE_ANALYTICS_ID=
GOOGLE_SITE_VERIFICATION=
